# Copy to .env (gitignored) and adjust. Placeholder local-dev values only:
# never put a real Neon or production credential in this file.
# Plain KEY=value lines, no quotes: compose, Spring (local profile) and the
# shell all read this file.

# Local Postgres from compose.yaml. Host port 5433 because a native
# PostgreSQL service may already listen on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finpath
DB_USER=finpath
DB_PASSWORD=change-me-local-only

# Production (Neon), prod profile only. One variable holds the full connection string that the
# Neon console shows for the POOLED endpoint: a postgres-scheme URL with user, password, host,
# database and the sslmode / channel_binding query parameters. Paste it into the host's secret
# store or your untracked .env; never into a tracked file. The app derives the JDBC URL, the
# credentials and the direct (non-pooler) Flyway endpoint from it.
# NEON_DATABASE_URL=

# Host port the api container is published on (loopback only) by `docker compose up`.
API_PORT=8080
