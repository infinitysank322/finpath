# Copy to .env (gitignored) and adjust. Placeholder local-dev values only:
# never put a real Neon or production credential in this file.
# Plain KEY=value lines, no quotes: compose, Spring (local profile) and the
# shell all read this file.

# Local Postgres from compose.yaml. Host port 5433 because a native
# PostgreSQL service may already listen on 5432.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=finpath
DB_USER=finpath
DB_PASSWORD=change-me-local-only

# Production (Neon), prod profile only. One variable holds the full connection string that the
# Neon console shows for the POOLED endpoint: a postgres-scheme URL with user, password, host,
# database and the sslmode / channel_binding query parameters. Paste it into the host's secret
# store or your untracked .env; never into a tracked file. The app derives the JDBC URL, the
# credentials and the direct (non-pooler) Flyway endpoint from it.
# NEON_DATABASE_URL=

# --- Sign-in (T29). All four are required to start the api; leave the real values to your
# untracked .env or the host's secret store, never a tracked file. ---
# Google OAuth client (Web application type) from the Google Cloud console. Its authorised
# redirect URI is the api's callback, not the web app's: {api base URL}/login/oauth2/code/google,
# i.e. keep http://localhost:8080/login/oauth2/code/google locally (not :4200).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# HS256 key for FinPath access tokens, at least 32 bytes. Generate: openssl rand -base64 48
FINPATH_JWT_SECRET=
# Comma-separated exact-match list of client return URLs after sign-in (no wildcards).
# Locally the web dev server; the Android app later adds com.finpath.app://auth/callback.
FINPATH_AUTH_ALLOWED_REDIRECTS=http://localhost:4200/auth/callback
# Comma-separated exact browser origins allowed to call the api (no "*"); Capacitor's https://localhost is added at T43b.
FINPATH_CORS_ALLOWED_ORIGINS=http://localhost:4200

# Host port the api container is published on (loopback only) by `docker compose up`.
API_PORT=8080
